VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_APP_URL=https://your-app.web.app
VITE_FIREBASE_VAPID_KEY=

# Optional emulator hosts for local development:
# VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
# VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=localhost:5001

# TMDB and YouTube API keys are intentionally NOT included here.
# They live only in the Firebase Cloud Function environment (Secret Manager).
# Adding them as VITE_* variables would bundle them into the browser JS and expose them publicly.
# See functions/src/enrich.ts — all enrichment goes through the Cloud Function.
