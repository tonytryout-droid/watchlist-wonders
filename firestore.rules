rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // User's own data — full access
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public bookmarks — anyone can read if is_public == true scoped to /users/{uid}/bookmarks
    match /users/{uid}/bookmarks/{bookmarkId} {
      allow read: if resource.data.is_public == true
        || (request.auth != null && request.auth.uid == uid);
    }

    // Feed items — owner can read their own feed; writes restricted to Cloud Functions only
    match /feed/{uid}/items/{itemId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Public profiles — readable by anyone. These docs contain only display_name/bio
    // and avatar metadata, so the public profile route can be exposed without auth.
    match /users/{uid}/profile/public {
      allow read: if true;
    }

    // Social graph — following list: owner-only access
    match /users/{uid}/following/{followingUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Social graph — followers list. Cross-user WRITE only (User A adds/removes themselves
    // from User B's followers list). Owner reads via the catch-all /users/{uid}/{document=**}
    // rule above. We deliberately do NOT allow followerUid==auth.uid reads here — that would
    // let an attacker probe "do I follow uid X?" via Bob's followers list. The owner of the
    // following list (the catch-all) is the right place to answer that question.
    match /users/{uid}/followers/{followerUid} {
      allow write: if request.auth != null && request.auth.uid == followerUid;
    }

    // Analytics aggregates — admin-only read; writes are server-side (Functions) only
    match /analytics/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Resolver training/debug events are written by Cloud Functions only.
    match /resolutionEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Entity cache — read by Cloud Functions; clients have no business reading it.
    match /entityCache/{hash} {
      allow read, write: if false;
    }

    // Client-side error reports — authenticated users can append; admins read.
    // No update/delete (immutable audit log). Shape is validated at the report
    // sink (src/services/errorMonitoring.ts); rules just gate the action.
    match /errorReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
