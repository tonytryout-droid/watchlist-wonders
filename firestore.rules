rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // User's own data — full access
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public bookmarks — anyone can read if is_public == true scoped to /users/{uid}/bookmarks
    match /users/{uid}/bookmarks/{bookmarkId} {
      allow read: if resource.data.is_public == true
        || (request.auth != null && request.auth.uid == uid);
    }

    // Feed items — owner can read their own feed; writes restricted to Cloud Functions only
    match /feed/{uid}/items/{itemId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Public profiles — anyone can read
    match /users/{uid}/profile/public {
      allow read: if true;
    }

    // Social graph — following list: owner-only access
    match /users/{uid}/following/{followingUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Social graph — followers list: owner can read; authenticated users can write/delete
    // their own record (so User A can add/remove themselves from User B's followers list)
    match /users/{uid}/followers/{followerUid} {
      allow read: if request.auth != null && request.auth.uid == followerUid;
      allow write: if request.auth != null && request.auth.uid == followerUid;
    }

    // Analytics aggregates — admin-only read; writes are server-side (Functions) only
    match /analytics/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Entity cache — read by Cloud Functions; clients have no business reading it.
    match /entityCache/{hash} {
      allow read, write: if false;
    }
  }
}
